# Copy to .env.production on the server and supply real secrets via your secrets manager.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MFA_FERNET_KEY=REPLACE_WITH_FERNET_GENERATE_KEY_OUTPUT
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://shop.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com
SECURE_SSL_REDIRECT=True

DB_HOST=YOUR_POSTGRES_HOST
DB_PORT=5432
DB_NAME=mallbyte
DB_USER=mallbyte_runtime
DB_PASSWORD=REPLACE_WITH_SECRET

REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
CACHE_BACKEND=redis
CACHE_REDIS_URL=redis://YOUR_REDIS_HOST:6379/1
CELERY_BROKER_URL=redis://YOUR_REDIS_HOST:6379/0
CELERY_RESULT_BACKEND=redis://YOUR_REDIS_HOST:6379/1

# Configure a real provider. Do not use console email in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=YOUR_SMTP_HOST
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=YOUR_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_WITH_SECRET
DEFAULT_FROM_EMAIL=noreply@api.example.com
