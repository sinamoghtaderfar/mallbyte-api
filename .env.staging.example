# Copy to .env.staging on your isolated STAGING host and provision secrets out of band.
# DO NOT reuse production credentials, databases, private media or payment endpoints.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=REPLACE_WITH_STAGING_ONLY_SECRET
MFA_FERNET_KEY=REPLACE_WITH_STAGING_ONLY_FERNET_KEY
ALLOWED_HOSTS=staging-api.example.com
CSRF_TRUSTED_ORIGINS=https://staging-api.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
SECURE_SSL_REDIRECT=True
DB_HOST=STAGING_DATABASE_HOST
DB_PORT=5432
DB_NAME=mallbyte_staging
DB_USER=mallbyte_staging
DB_PASSWORD=REPLACE_WITH_STAGING_ONLY_PASSWORD
DB_SSLMODE=require
# DB_SSLROOTCERT=/run/secrets/staging-postgres-ca.crt
REDIS_URL=redis://STAGING_REDIS_HOST:6379/0
CACHE_BACKEND=redis
CACHE_REDIS_URL=redis://STAGING_REDIS_HOST:6379/1
CELERY_BROKER_URL=redis://STAGING_REDIS_HOST:6379/0
CELERY_RESULT_BACKEND=redis://STAGING_REDIS_HOST:6379/1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=STAGING_SMTP_SERVER
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=STAGING_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_WITH_STAGING_ONLY_PASSWORD
DEFAULT_FROM_EMAIL=staging@staging.example.com
